 "phrases": [
  {
   "text": "In 1872,",
   "s": 0.0,
   "e": 1.602
  },
  {
   "text": "sailors boarded a ship in the middle of the Atlantic.",
   "s": 2.178,
   "e": 5.337
  },
  {
   "text": "The ship was in perfect order.",
   "s": 5.891,
   "e": 7.783
  },
  {
   "text": "The crew was gone.",
   "s": 8.415,
   "e": 9.853
  },
  {
   "text": "The Mary Celeste had left New York a month earlier with ten people aboard,",
   "s": 10.599,
   "e": 13.552
  },
  {
   "text": "including the captain's wife and their little girl.",
   "s": 13.918,
   "e": 16.861
  },
  {
   "text": "The cargo was untouched.",
   "s": 17.266,
   "e": 19.478
  },
  {
   "text": "The food and water were untouched. Only the lifeboat was missing.",
   "s": 19.777,
   "e": 24.036
  },
  {
   "text": "So ten people climbed into a tiny open boat and left a working ship behind.",
   "s": 24.763,
   "e": 29.796
  },
  {
   "text": "Nobody has ever found them.",
   "s": 30.44,
   "e": 32.202
  }
 ]
